                    "5": "firmaciv:wood/watercraft_frame/angled/hickory[facing=east,shape=inner_left,frame_processed=3]",
                    "6": "firmaciv:wood/watercraft_frame/angled/hickory[facing=east,shape=inner_right,frame_processed=3]"
                }
            },
            "name": "已填充的脚手架",
            "text": "每个脚手架中都加入了四块$(6)$(t:#tfg:hardwood)硬木$()木板方块。",
            "enable_visualize": false
        },
        {
            "type": "patchouli:multiblock",
            "multiblock": {
                "pattern": [
                    [
                        "   ",
