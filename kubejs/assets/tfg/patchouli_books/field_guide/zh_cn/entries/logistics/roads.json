                        "DDCCRROMM",
                        "DDCCROMMM"
                    ]
                ],
                "mapping": {
                    "D": "rnr:tamped_loam",
                    "C": "rnr:base_course",
                    "R": "rnr:rock/gravel_road/chert",
                    "O": "rnr:rock/over_height_gravel/chert",
                    "M": "rnr:rock/macadam_road/chert"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "anchor": "stone",
            "item": "tag:rnr:flagstone_road_items,tag:rnr:cobble_road_items,tag:rnr:brick_road_items",
            "title": "石质铺面材料",
            "text": "基层之上可以铺设多种不同的石质步行路面，全部提供$(thing)$(bold)20% 速度加成$()。$(li)$(thing)$(bold)圆石路$()：在基层上添加$(item)石子$()即可筑成。$(li)$(thing)$(bold)仿石砖路$()：用石头或陶制的$(item)砖$()筑成。$(li)$(thing)$(bold)铺路砖路$()：用石头或砂岩的$(item)铺路砖$()筑成。"
        },
