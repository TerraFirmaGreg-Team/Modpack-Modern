                            "   0   ",
                            "   X   "
                        ]
                    ],
                    "mapping": {
                        "X": "create:item_vault[axis=z,large=false]"
                    }
                },
                {
                    "pattern": [
                        [
                            "       ",
                            "       ",
                            "       "
                        ],
                        [
                            "       ",
