                        "X": "create:item_vault[axis=z,large=true]"
                    }
                }
            ]
        },
        {
            "type": "patchouli:spotlight",
            "title": "超级箱",
            "anchor": "super_chests",
            "item": "tag:gtceu:super_chests",
            "text": "超级箱和量子箱是存放海量单一物品的最佳方式。箱子可容纳的物品数量随等级提升，从 10,000 到 1,024,000,000。超级箱还内置了物品销毁、锁定和自动抽取选项。"
        },
        {
            "type": "patchouli:multiblock",
            "enable_visualize": false,
            "text": "$(bold)提示$()：超级箱可以在装有物品的情况下直接搬走。",
            "multiblock": {
                "pattern": [
                    [
                        "X"
                    ],
                    [
                        "0"
                    ]
                ],
                "mapping": {
                    "X": "#gtceu:super_chests"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "title": "ME 存储",
            "anchor": "ae2",
            "item": "ae2:drive",
            "text": "AE2 的$(item)ME驱动器$()和$(item)存储元件$()能让你把存储数字化，构成能力强大且高度密集的物流与合成网络。接上$(item)ME控制器$()和$(thing)终端$()即可查看其中的物品。"
        },
        {
            "type": "patchouli:multiblock",
            "enable_visualize": false,
            "text": "$(bold)提示$()：更高等级的存储元件能容纳更多物品种类，以及更多「字节」。",
            "multiblock": {
                "pattern": [
                    [
                        "X"
                    ],
                    [
                        "0"
                    ]
                ],
                "mapping": {
                    "X": "ae2:drive"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "title": "大酒桶",
            "anchor": "kegs",
            "item": "tag:firmalife:big_barrels",
            "text": "$(item)大酒桶$()拥有独一无二的存储能力，可以同时存放大量物品$(italics)和$()流体。$(br)大酒桶能装任何大桶能装的流体，最多 80,000 mB，还能容纳最多 36 组$(l:game_mechanics/size_and_weight)大型$()物品。$(br2)但大酒桶不能像大桶那样处理配方或陈酿美酒。"
        },
        {
            "type": "patchouli:multiblock",
            "enable_visualize": false,
            "text": "$(bold)提示$()：可以从大酒桶的任意一个方块自动输入和抽取。",
            "multiblock": {
                "pattern": [
                    [
                        "67",
                        "45"
                    ],
                    [
                        "23",
                        "01"
                    ]
                ],
                "mapping": {
                    "0": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=0]",
                    "1": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=1]",
                    "2": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=2]",
                    "3": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=3]",
                    "4": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=4]",
                    "5": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=5]",
                    "6": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=6]",
                    "7": "firmalife:wood/big_barrel/oak[facing=south,barrel_part=7]"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "title": "大桶",
            "anchor": "barrels",
            "item": "tag:tfc:barrels",
            "text": "$(l:craftsmanship/barrels)大桶$()不只对配方有用。它们是储存大量流体非常廉价的方式，每桶最多 10,000 mB。$(br)侧放时，大桶可以从龙头把流体滴进下方的容器，从而以稳定的速率自动输出。$(br)你还可以把装满的大桶背在背上运输其中的东西。"
        },
        {
            "type": "patchouli:multiblock",
            "enable_visualize": false,
            "text": "$(bold)提示$()：大桶敞口朝天空放置时可以收集雨水。",
            "multiblock": {
                "pattern": [
                    [
                        "X"
                    ],
                    [
                        "0"
                    ]
                ],
                "mapping": {
                    "X": "#tfc:barrels[facing=up]"
                }
            }
        },
        {
            "type": "patchouli:text",
            "title": "桶",
            "anchor": "drums",
            "item": "tag:gtceu:drums",
            "text": "$(item)储液桶$()非常适合存储和携带流体。它们能存放大量单一类型的流体，等级越高容量越大，从 32,000 到 1,024,000 mB 不等。$(br2)储液桶被拆除时会保留其中的流体，是转移流体的理想选择。$(br2)用 $(item)$(k:key.use)$() 配合$(thing)软锤$()或$(thing)螺丝刀$()，即可让储液桶从底面自动排出流体。"
        },
        {
            "type": "patchouli:multiblock",
            "enable_visualize": false,
            "text": "$(bold)提示$()：储液桶的各个面都可以放置流体物流覆盖板。",
            "multiblock": {
                "pattern": [
                    [
                        "X"
                    ],
                    [
                        "0"
                    ]
                ],
                "mapping": {
                    "X": "#gtceu:drums"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "title": "储液罐",
            "anchor": "fluid_tanks",
            "item": "create:fluid_tank,create_connected:fluid_vessel,fluidlogistics:multi_fluid_tank",
            "text": "$(item)储液罐$()可以看作$(l:logistics/storage#vaults)物品保险库$()的流体版本。单个储液罐可容纳 32,000 mB，还可以拼成结构以扩展容量。$(br2)$(item)多流体储罐$()可以同时容纳多种流体，但无法手动与之交互。"
        },
