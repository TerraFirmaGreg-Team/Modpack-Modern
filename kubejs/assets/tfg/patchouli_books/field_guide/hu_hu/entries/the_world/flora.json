        {
            "anchor": "medicinal_plants",
            "type": "patchouli:spotlight",
            "item": {
                "tag": "tfg:medicinal_ingredients/plants"
            },
            "title": "Medicinal Plants",
            "text": "Many plants in $(tfg) hold medicinal value and can be used for creating phytotherapeutic medicine. You can combine these ingredients in a mixing bowl with wax, binders, and spring water to make pills. Or more advanced medications."
        },
