                    "C": "rnr:base_course",
                    "R": "rnr:hoggin"
                }
            }
        },
        {
            "type": "patchouli:spotlight",
            "anchor": "gravel_fill",
            "item": "tag:rnr:gravel_road_items",
            "title": "礫石與碎石路",
            "text": "在基層上鋪少量$(thing)礫石填料$()，可以做出簡單的小路，提供小幅的$(thing)$(bold)10% 加成$()行走速度。再加入更多礫石填料並夯實，即可做出提供$(thing)$(bold)20% 速度加成$()的$(thing)碎石路$()。$(br)所有比混合砂礫更高級的鋪面材料都能讓$(item)畜力把手$()以 32RPM 運轉。"
        },
        {
            "type": "patchouli:multiblock",
            "text": "以礫石填料建造道路。",
            "enable_visualize": false,
            "multiblock": {
