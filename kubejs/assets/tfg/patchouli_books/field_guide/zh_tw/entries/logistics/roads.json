            "border": true,
            "text": "鋪路車有一種會以隨機圖案鋪設鋪面材料的模式。"
        },
        {
            "type": "patchouli:image",
            "title": "隨機材料路徑",
            "images": [
                "tfg:textures/gui/field_guide/paving_cart/tfg_paving_cart_path_random.png"
            ],
            "border": true
        },
