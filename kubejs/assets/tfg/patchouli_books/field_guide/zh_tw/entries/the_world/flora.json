                "mapping": {
                    "X": "tfc:plant/anthurium"
                }
            },
            "name": "一般",
            "anchor": "standard_plants",
            "text": "普通植物就像小花。它們會生長在草地、泥土和農田上。",
            "enable_visualize": false
        },
