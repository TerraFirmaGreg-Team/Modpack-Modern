        {
            "type": "patchouli:spotlight",
            "anchor": "copper_pot",
            "item": "tfg:copper_pot",
            "title": "Copper Pot",
            "link_recipes": false,
            "text": "The $(thing)Copper Pot$() is a versitile appliance which comes with a suite of optional attachments. Copper pots can hold multiple fluid and item inputs as well as special bowl and tool slots. When broken, the pot will retain these items for transport similar to a $(l:craftsmaship/barrels)Barrel$(). Hoppers, pipes, and other logistic methods can interact with copper pots."
        },
        {
            "type": "tfg:multimultiblock",
            "name": "",
