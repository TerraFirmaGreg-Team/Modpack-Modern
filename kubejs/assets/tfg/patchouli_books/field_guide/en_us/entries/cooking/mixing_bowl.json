    "pages": [
        {
            "type": "patchouli:text",
            "text": "The $(thing)Mixing Bowl$() is an appliance for mixing items and fluids together. It can accept 3 input items and 2 input fluids to run recipes. Some recipes require tools or bowls which will go in their respective slots in the GUI. If a tool is required, after inserting it, $(item)$(k:key.use)$() its hitbox to start a recipe."
        },
        {
            "type": "tfg:multimultiblock",
