                        " A "
                    ]
                ],
                "mapping": {
                    "B": "tfc:bloomery[facing=north]",
                    "A": "tfc:rock/smooth/dacite"
                }
            },
            "name": "Устройство сыродутного горна",
            "text": "Полноразмерный сыродутный горн. Блок сыродутного горна открывается и закрывается по $(item)$(k:key.use)$().",
            "enable_visualize": true
        },
        {
            "type": "patchouli:text",
            "text": "В сыродутный горн помещается до 48 $(thing)загружаемых предметов$(), по 16 на каждый ярус трубы: 8 древесного угля и 8 предметов с железом.$(br2)Чтобы загрузить горн, заберись наверх и бросай предметы внутрь клавишей $(item)$(k:key.drop)$(). Должна вырасти башенка серой руды.$(br2)Топливом для сыродутного горна может быть только $(item)древесный уголь$()."
        },
        {
            "type": "patchouli:image",
            "images": [
                "tfc:textures/gui/book/tutorial/bloomery_hole.png"
            ],
            "text": "Горну требуется $(thing)1 Древесный уголь$(), и $(thing)144 мБ (mB) Железной руды$() чтобы создать одну $(thing)Крицу$().",
            "border": true
        },
        {
            "type": "patchouli:text",
            "text": "В большинстве железной пыли 129 mB железа, так что, если ты не используешь чистые чугунные слитки, на полный горн советуем $(item)25 порций рудной пыли$() и $(item)22 древесного угля$(). Потеряется 57 mB железа.$(br)Загрузив в горн смесь $(thing)топлива$() и $(thing)руды$(), подожги дверцу и подожди $(t:12,5 мин)$(6)15 игровых часов$(), пока всё переплавится. Когда горн погаснет, после него останется блок $(thing)сыродутного шлака$(). В нём горячие $(thing)крицы$(): добывай их, раз за разом ломая $(thing)шлак$() киркой."
